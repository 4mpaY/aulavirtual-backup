# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3000
BASEPATH=3000

# Base de Datos PostgreSQL
# Generar contraseña segura: openssl rand -base64 32
DB_DRIVER='postgresql'
DB_HOST='localhost'
DB_PORT=5432
DB_NAME='aulavirtual2'
DB_USER='postgres'
DB_PASSWORD='CAMBIAR_POR_CONTRASENA_SEGURA_GENERADA_CON_openssl_rand_base64_32'
DATABASE_URL="${DB_DRIVER}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# JWT — Generar con: openssl rand -base64 64
# IMPORTANTE: Deben ser DISTINTOS entre sí y nunca compartirse
JWT_SECRET='CAMBIAR_POR_SECRETO_UNICO_openssl_rand_base64_64'

# NextAuth — Generar con: openssl rand -base64 64
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET='CAMBIAR_POR_SECRETO_DIFERENTE_AL_JWT_SECRET_openssl_rand_base64_64'

# Branding
NEXT_PUBLIC_TEMPLATE_NAME='NOMBRE_DE_TU_EMPRESA'
NEXT_PUBLIC_TEMPLATE_SLOGAN='Tu slogan aquí'
NEXT_PUBLIC_SETTINGS_COOKIE_NAME='NOMBRE_COOKIE'
NEXT_PUBLIC_TEMPLATE_LOGO='/images/logo.png'
NEXT_PUBLIC_PRIMARY_COLOR_MAIN='#148fcd'
NEXT_PUBLIC_PRIMARY_COLOR_LIGHT='#8dc9e7'
NEXT_PUBLIC_PRIMARY_COLOR_DARK='#9196F2'

# Izipay Web Core
# Obtener credenciales reales en: https://secure.micuentaweb.pe
IZIPAY_MERCHANT_CODE='TU_CODIGO_DE_COMERCIO_IZIPAY'
IZIPAY_API_KEY='TU_API_KEY_IZIPAY'
IZIPAY_RSA_KEY='TU_RSA_KEY_IZIPAY'
IZIPAY_ENDPOINT='https://sandbox-api-pw.izipay.pe'
NEXT_PUBLIC_IZIPAY_SDK_URL='https://sandbox-checkout.izipay.pe/payments/v1/js/index.js'

# PayPal API (Server Side)
# Obtener en: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID='TU_PAYPAL_CLIENT_ID'
PAYPAL_CLIENT_SECRET='TU_PAYPAL_CLIENT_SECRET'
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# PayPal Client (Frontend - visible en el navegador)
NEXT_PUBLIC_PAYPAL_CLIENT_ID='TU_PAYPAL_CLIENT_ID_PUBLICO'

# Google OAuth (opcional)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID='TU_GOOGLE_CLIENT_ID'
GOOGLE_CLIENT_SECRET='TU_GOOGLE_CLIENT_SECRET'
