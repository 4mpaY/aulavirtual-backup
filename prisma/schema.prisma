generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String            @id @default(uuid())
  correo             String            @unique
  contrasena         String?
  numero_documento   String?           @unique
  nombre             String
  apellido           String
  avatar             String?
  google_id          String?           @unique
  biografia          String?
  celular            String?
  rol                Rol               @default(ESTUDIANTE)
  esta_activo        Boolean           @default(true)
  creado_en          DateTime          @default(now())
  actualizado_en     DateTime          @updatedAt
  certificados       Certificado[]
  comentarios        Comentario[]
  cursos_dictados    Curso[]           @relation("ProfesorCursos")
  inscripciones      Inscripcion[]
  intentos_examen    IntentoExamen[]
  pedidos            Pedido[]
  progreso_cursos    ProgresoCurso[]
  notificaciones     Notificacion[]
  progreso_lecciones ProgresoLeccion[]

  @@index([rol])
  @@map("usuarios")
}

model Categoria {
  id                 String      @id @default(uuid())
  nombre             String      @unique
  slug               String      @unique
  descripcion        String?
  categoria_padre_id String?
  esta_activo        Boolean     @default(true)
  creado_en          DateTime    @default(now())
  actualizado_en     DateTime    @updatedAt
  orden              Int         @default(0)
  padre              Categoria?  @relation("JerarquiaCategoria", fields: [categoria_padre_id], references: [id])
  hijos              Categoria[] @relation("JerarquiaCategoria")
  cursos             Curso[]

  @@index([categoria_padre_id])
  @@map("categorias")
}

model Curso {
  id                 String          @id @default(uuid())
  titulo             String
  slug               String          @unique
  descripcion        String?
  miniatura          String?
  video_presentacion String?
  duracion           String?
  tipo_emision       TipoEmision     @default(ASINCRONO)
  estado             EstadoCurso     @default(BORRADOR)
  es_gratis          Boolean         @default(false)
  precio             Decimal         @default(0) @db.Decimal(10, 2)
  precio_oferta      Decimal?        @db.Decimal(10, 2)
  moneda             String          @default("PEN")
  creado_en          DateTime        @default(now())
  actualizado_en     DateTime        @updatedAt
  profesor_id        String
  categoria_id       String?
  nivel              NivelCurso      @default(BASICO)
  beneficios         Json?           @default("[]")
  incluye            Json?           @default("[]")
  metodologia        Json?           @default("[]")
  objetivos          Json?           @default("[]")
  fecha_inicio       DateTime?
  certificados       Certificado[]
  categoria          Categoria?      @relation(fields: [categoria_id], references: [id])
  profesor           Usuario         @relation("ProfesorCursos", fields: [profesor_id], references: [id], onDelete: Cascade)
  detalles_pedido    DetallePedido[]
  examenes           Examen[]
  inscripciones      Inscripcion[]
  modulos            Modulo[]
  progreso           ProgresoCurso[]
  rutas              CursoEnRuta[]

  @@index([profesor_id])
  @@index([categoria_id])
  @@index([estado])
  @@map("cursos")
}

model Modulo {
  id             String    @id @default(uuid())
  titulo         String
  descripcion    String?
  orden          Int
  creado_en      DateTime  @default(now())
  actualizado_en DateTime  @updatedAt
  curso_id       String
  lecciones      Leccion[]
  curso          Curso     @relation(fields: [curso_id], references: [id], onDelete: Cascade)

  @@unique([curso_id, orden])
  @@index([curso_id])
  @@map("modulos")
}

model Leccion {
  id              String             @id @default(uuid())
  titulo          String
  contenido       String?
  orden           Int
  duracion        Int?
  enlace_reunion  String?
  estado          EstadoLeccion      @default(PUBLICADO)
  creado_en       DateTime           @default(now())
  actualizado_en  DateTime           @updatedAt
  modulo_id       String
  recursos        Json?              @default("[]")
  video_url       String?
  es_en_vivo       Boolean            @default(false)
  fecha_programada DateTime?
  es_vista_previa  Boolean            @default(false)
  contenidos       ContenidoLeccion[]
  modulo           Modulo             @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  progreso         ProgresoLeccion[]
  comentarios      Comentario[]

  @@unique([modulo_id, orden])
  @@index([modulo_id])
  @@map("lecciones")
}

model ContenidoLeccion {
  id             String        @id @default(uuid())
  titulo         String?
  tipo           TipoContenido
  url            String
  orden          Int
  creado_en      DateTime      @default(now())
  actualizado_en DateTime      @updatedAt
  leccion_id     String
  leccion        Leccion       @relation(fields: [leccion_id], references: [id], onDelete: Cascade)

  @@index([leccion_id])
  @@map("contenidos_leccion")
}

model Pedido {
  id               String          @id @default(uuid())
  numero_pedido    Int             @unique @default(autoincrement())
  estado           EstadoPedido    @default(PENDIENTE)
  metodo_pago      MetodoPago?
  total            Decimal         @db.Decimal(10, 2)
  mensaje          String?
  moneda           String          @default("PEN")
  transaccion_id   String?         @unique
  referencia_pago  String?
  url_pago         String?
  token_pago       String?
  respuesta_izipay Json?
  creado_en        DateTime        @default(now())
  pagado_en        DateTime?
  cancelado_en     DateTime?
  actualizado_en   DateTime        @updatedAt
  usuario_id       String
  cupon_id         String?
  detalles         DetallePedido[]
  inscripciones    Inscripcion[]
  usuario          Usuario         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  cupon            Cupon?          @relation(fields: [cupon_id], references: [id])

  @@index([usuario_id])
  @@index([cupon_id])
  @@index([estado])
  @@index([transaccion_id])
  @@map("pedidos")
}

model DetallePedido {
  id              String  @id @default(uuid())
  cantidad        Int     @default(1)
  descuento       Decimal @default(0) @db.Decimal(10, 2)
  precio_unitario Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  pedido_id       String
  curso_id        String
  curso           Curso   @relation(fields: [curso_id], references: [id])
  pedido          Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id])
  @@index([curso_id])
  @@map("detalles_pedido")
}

model Inscripcion {
  id            String            @id @default(uuid())
  estado        EstadoInscripcion @default(ACTIVO)
  inscrito_en   DateTime          @default(now())
  completado_en DateTime?
  usuario_id    String
  curso_id      String
  pedido_id     String?
  curso         Curso             @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  pedido        Pedido?           @relation(fields: [pedido_id], references: [id])
  usuario       Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, curso_id])
  @@index([usuario_id])
  @@index([curso_id])
  @@index([pedido_id])
  @@map("inscripciones")
}

model ProgresoLeccion {
  id              String    @id @default(uuid())
  esta_completado Boolean   @default(false)
  completado_en   DateTime?
  usuario_id      String
  leccion_id      String
  leccion         Leccion   @relation(fields: [leccion_id], references: [id], onDelete: Cascade)
  usuario         Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, leccion_id])
  @@index([usuario_id])
  @@index([leccion_id])
  @@map("progreso_leccion")
}

model ProgresoCurso {
  id                  String   @id @default(uuid())
  porcentaje_progreso Float    @default(0)
  usuario_id          String
  curso_id            String
  actualizado_en      DateTime @updatedAt
  curso               Curso    @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  usuario             Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, curso_id])
  @@index([usuario_id])
  @@index([curso_id])
  @@map("progreso_curso")
}

model Examen {
  id                 String          @id @default(uuid())
  titulo             String
  descripcion        String?
  limite_tiempo      Int?
  puntaje_aprobacion Float           @default(60)
  intentos_maximos   Int             @default(1)
  mezclar_preguntas  Boolean         @default(false)
  esta_publicado     Boolean         @default(false)
  creado_en          DateTime        @default(now())
  actualizado_en     DateTime        @updatedAt
  curso_id           String
  curso              Curso           @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  intentos           IntentoExamen[]
  preguntas          Pregunta[]

  @@index([curso_id])
  @@map("examenes")
}

model Pregunta {
  id             String             @id @default(uuid())
  texto          String
  tipo           TipoPregunta
  puntos         Float              @default(1)
  orden          Int
  creado_en      DateTime           @default(now())
  actualizado_en DateTime           @updatedAt
  examen_id      String
  opciones       OpcionPregunta[]
  examen         Examen             @relation(fields: [examen_id], references: [id], onDelete: Cascade)
  respuestas     RespuestaIntento[]

  @@unique([examen_id, orden])
  @@index([examen_id])
  @@map("preguntas")
}

model OpcionPregunta {
  id              String             @id @default(uuid())
  texto           String
  es_correcta     Boolean            @default(false)
  orden           Int
  pregunta_id     String
  pregunta        Pregunta           @relation(fields: [pregunta_id], references: [id], onDelete: Cascade)
  seleccionada_en RespuestaIntento[] @relation("OpcionSeleccionada")

  @@index([pregunta_id])
  @@map("opciones_pregunta")
}

model IntentoExamen {
  id            String             @id @default(uuid())
  puntaje       Float?
  esta_aprobado Boolean?
  iniciado_en   DateTime           @default(now())
  enviado_en    DateTime?
  usuario_id    String
  examen_id     String
  examen        Examen             @relation(fields: [examen_id], references: [id], onDelete: Cascade)
  usuario       Usuario            @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  respuestas    RespuestaIntento[]

  @@index([usuario_id])
  @@index([examen_id])
  @@map("intentos_examen")
}

model RespuestaIntento {
  id                     String          @id @default(uuid())
  respuesta_texto        String?
  es_correcta            Boolean?
  puntos_obtenidos       Float?
  intento_id             String
  pregunta_id            String
  opcion_seleccionada_id String?
  intento                IntentoExamen   @relation(fields: [intento_id], references: [id], onDelete: Cascade)
  opcion_seleccionada    OpcionPregunta? @relation("OpcionSeleccionada", fields: [opcion_seleccionada_id], references: [id])
  pregunta               Pregunta        @relation(fields: [pregunta_id], references: [id], onDelete: Cascade)

  @@unique([intento_id, pregunta_id])
  @@index([intento_id])
  @@index([pregunta_id])
  @@map("respuestas_intento")
}

model Certificado {
  id                  String   @id @default(uuid())
  codigo_verificacion String   @unique
  emitido_en          DateTime @default(now())
  usuario_id          String
  curso_id            String
  curso               Curso    @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  usuario             Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, curso_id])
  @@index([usuario_id])
  @@index([curso_id])
  @@map("certificados")
}

model Tenant {
  id               String   @id @default(uuid())
  nombre           String
  dominio          String   @unique
  logo_url         String?
  favicon_url      String?
  color_primario   String   @default("#2e7d32")
  color_secundario String   @default("#0284c7")
  creado_en        DateTime @default(now())
  actualizado_en   DateTime @updatedAt
  esta_activo      Boolean  @default(true)

  @@map("tenants")
}

model Media {
  id             String   @id @default(uuid())
  nombre         String
  url            String
  tipo           String
  mimetype       String
  peso           Int
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("media")
}

model Notificacion {
  id         String   @id @default(uuid())
  titulo     String
  mensaje    String
  leida      Boolean  @default(false)
  enlace     String?
  tipo       String?
  usuario_id String
  creado_en  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("notificaciones")
}

model Comentario {
  id             String       @id @default(uuid())
  contenido      String
  creado_en      DateTime     @default(now())
  actualizado_en DateTime     @updatedAt
  usuario_id     String
  leccion_id     String
  respuesta_a_id String?
  usuario        Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  leccion        Leccion      @relation(fields: [leccion_id], references: [id], onDelete: Cascade)
  padre          Comentario?  @relation("Respuestas", fields: [respuesta_a_id], references: [id], onDelete: Cascade)
  respuestas     Comentario[] @relation("Respuestas")

  @@index([usuario_id])
  @@index([leccion_id])
  @@index([respuesta_a_id])
  @@map("comentarios")
}

model Cupon {
  id               String         @id @default(uuid())
  codigo           String         @unique
  valor            Decimal        @db.Decimal(10, 2)
  tipo             TipoDescuento  @default(PORCENTAJE)
  limite_uso       Int?
  usos_actuales    Int            @default(0)
  fecha_expiracion DateTime?
  esta_activo      Boolean        @default(true)
  creado_en        DateTime       @default(now())
  actualizado_en   DateTime       @updatedAt
  pedidos          Pedido[]

  @@map("cupones")
}

enum Rol {
  ADMIN
  PROFESOR
  ESTUDIANTE
}

enum EstadoCurso {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum EstadoInscripcion {
  PENDIENTE
  ACTIVO
  COMPLETADO
  CANCELADO
}

enum EstadoPedido {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  CANCELADO
  REEMBOLSADO
}

enum MetodoPago {
  TARJETA_CREDITO
  TARJETA_DEBITO
  YAPE
  PLIN
  TRANSFERENCIA
  PAYPAL
  IZIPAY
  OTRO
}

enum TipoPregunta {
  OPCION_MULTIPLE
  VERDADERO_FALSO
  RESPUESTA_ABIERTA
}

enum TipoContenido {
  VIDEO
  DOCUMENTO
  IMAGEN
  AUDIO
  ENLACE
  INCRUSTADO
}

enum EstadoLeccion {
  BORRADOR
  PUBLICADO
}

enum TipoEmision {
  SINCRONO
  ASINCRONO
  MIXTO
}

enum NivelCurso {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

model Configuracion {
  id             String   @id @default(uuid())
  clave          String   @unique
  valor          String
  descripcion    String?
  actualizado_en DateTime @updatedAt

  @@map("configuraciones")
}

model RutaAprendizaje {
  id             String         @id @default(uuid())
  titulo         String
  slug           String         @unique
  descripcion    String?
  miniatura      String?
  beneficios     Json?          @default("[]")
  secciones      Json?          @default("[]")
  esta_activo    Boolean        @default(true)
  creado_en      DateTime       @default(now())
  actualizado_en DateTime       @updatedAt
  cursos         CursoEnRuta[]

  @@map("rutas_aprendizaje")
}

model CursoEnRuta {
  id                String          @id @default(uuid())
  orden             Int
  seccion_id        String?
  creado_en         DateTime        @default(now())
  actualizado_en    DateTime        @updatedAt
  ruta_id           String
  curso_id          String
  ruta              RutaAprendizaje @relation(fields: [ruta_id], references: [id], onDelete: Cascade)
  curso             Curso           @relation(fields: [curso_id], references: [id], onDelete: Cascade)

  @@unique([ruta_id, curso_id])
  @@index([ruta_id])
  @@index([curso_id])
  @@map("cursos_en_ruta")
}
